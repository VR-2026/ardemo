        <botDialogs>
            <botSteps>
                <botMessages>
                    <message>Hi, I&apos;m Agentforce! I use AI to search trusted sources, and more. Ask me &quot;What else can you do?&quot; to see how I can simplify your workday. How can I help??</message>
                    <messageIdentifier>49b15f52-6656-4bde-a7c1-db368e70adaf</messageIdentifier>
                </botMessages>
                <stepIdentifier>a71f4e6b-ba50-4375-9cf9-aa6c1ba6ec42</stepIdentifier>
                <type>Message</type>
            </botSteps>
            <botSteps>
                <stepIdentifier>bc90496e-e573-4d35-b0e8-3cfeba21f0aa</stepIdentifier>
                <type>Wait</type>
            </botSteps>
            <developerName>Welcome</developerName>
            <label>Welcome</label>
            <showInFooterMenu>false</showInFooterMenu>
        </botDialogs>
        <botDialogs>
            <botSteps>
                <botMessages>
                    <message>Something went wrong. Try again.</message>
                    <messageIdentifier>89c44987-d469-49e8-8c3f-ff5785252293</messageIdentifier>
                </botMessages>
                <stepIdentifier>23b6b09c-c0f7-41a0-8385-8cb3fa28797e</stepIdentifier>
                <type>Message</type>
            </botSteps>
            <botSteps>
                <stepIdentifier>1e052fc3-76d6-42a2-8d13-6d9b65e5d7a5</stepIdentifier>
                <type>Wait</type>
            </botSteps>
            <developerName>Rich_Content_Error_Handling</developerName>
            <label>Error Handler</label>
            <showInFooterMenu>false</showInFooterMenu>
        </botDialogs>
        <botDialogs>
            <developerName>Transfer_To_Agent</developerName>
            <label>Transfer To Agent</label>
            <showInFooterMenu>false</showInFooterMenu>
        </botDialogs>
