        </conversationVariables>
        <conversationVariables>
            <dataType>Text</dataType>
            <description>Stores the Salesforce Case ID created by an inbound email.</description>
            <developerName>emailCaseId</developerName>
            <includeInPrompt>false</includeInPrompt>
            <label>Email Case Id</label>
            <visibility>External</visibility>
        </conversationVariables>
        <conversationVariables>
            <dataType>Text</dataType>
            <description>Stores the customer ID type, whether it&apos;s a Salesforce user or a contact.</description>
            <developerName>customerType</developerName>
            <includeInPrompt>false</includeInPrompt>
            <label>Customer Type</label>
            <visibility>Internal</visibility>
        </conversationVariables>
        <conversationVariables>
            <dataType>Text</dataType>
            <description>Stores the Salesforce Contact ID associated with the end user who sent the inbound email.</description>
            <developerName>endUserContactId</developerName>
